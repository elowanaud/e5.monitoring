          "expr": "(max by (instance) (100 * (1 - (node_filesystem_avail_bytes{job=\"node_exporter\", instance=~\"$node\", fstype!~\"^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|erofs|sysfs|tmpfs|tracefs)$\", mountpoint!~\"^/(dev|proc|sys|run|var/lib/docker/.+|var/lib/kubelet/.+)($|/)\"} / node_filesystem_size_bytes{job=\"node_exporter\", instance=~\"$node\", fstype!~\"^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|erofs|sysfs|tmpfs|tracefs)$\", mountpoint!~\"^/(dev|proc|sys|run|var/lib/docker/.+|var/lib/kubelet/.+)($|/)\"}))) * on (instance) group_left (nodename) node_uname_info{job=\"node_exporter\", instance=~\"$node\"}) and on (instance) (up{job=\"node_exporter\", instance=~\"$node\"} == 1)",
          "instant": true,
          "legendFormat": "{{nodename}}",
          "range": false,
          "refId": "A"
