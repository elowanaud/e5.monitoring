          },
          "editorMode": "code",
          "expr": "((100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node_exporter\", instance=~\"$node\", mode=\"idle\"}[$__rate_interval])))) * on (instance) group_left (nodename) node_uname_info{job=\"node_exporter\", instance=~\"$node\"}) and on (instance) (up{job=\"node_exporter\", instance=~\"$node\"} == 1)",
